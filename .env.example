# Local-only project ID. This explicitly uses the Firestore emulator.
GOOGLE_CLOUD_PROJECT=demo-hotel-price-hunter
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
PORT=8080
APP_ORIGIN=http://localhost:8080

# Leave these unset until an existing app project / model is authorised.
# Live Gemini requires ADC or Cloud Run's attached service account, never browser keys.
# For live Gemini with local storage, use an authorised GOOGLE_CLOUD_PROJECT above.
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=

# Opt in separately for the quotation-backed Gemini review. No startup generation.
# Keep off until a live testing / deployment call allowance is authorised.
# QUOTATION_ADVICE_ENABLED=true

# Enable only for explicit local emulator integration tests.
# RUN_FIRESTORE_INTEGRATION=1
