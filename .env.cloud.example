# Review template only. The deployment script sets these non-secret values explicitly.
# Do not copy local emulator or host ADC variables into Cloud Run.
GOOGLE_CLOUD_PROJECT=sincere-apex-511418-p0
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
NODE_ENV=production
PORT=8080
# Private initial deployment uses this strict HTTPS placeholder. Then set the exact
# canonical origin returned by Cloud Run status.url before any public access.
APP_ORIGIN=https://origin-not-ready.invalid
# FIRESTORE_EMULATOR_HOST, GOOGLE_APPLICATION_CREDENTIALS, tokens and API keys absent.
# Runtime credentials come solely from the attached hotel-price-hunter-runtime SA.
