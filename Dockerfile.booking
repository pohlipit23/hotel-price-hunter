FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY app ./app
# The release context holds exactly one of booking-demo.json or booking-catalogue.json.
COPY booking-*.json ./release/
ENV NODE_ENV=production PORT=8080
USER node
EXPOSE 8080
CMD ["node", "app/booking-cloud.mjs"]
