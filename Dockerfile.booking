FROM node:24-bookworm-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts
COPY app ./app
# Only reviewed code/version pins are packaged. Booking and session facts come from Firestore.
COPY booking-catalogue-manifest.json ./release/
ENV NODE_ENV=production PORT=8080
USER node
EXPOSE 8080
CMD ["node", "app/booking-cloud.mjs"]
